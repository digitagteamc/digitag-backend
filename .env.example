# ============================================================
# APP
# ============================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=*
WEBSITE_URL=https://thedigitag.ai
API_PUBLIC_URL=https://api.thedigitag.ai/api/v1

# AiSensy (WhatsApp) — event ticket sends. Leave blank to no-op.
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digitag?schema=public"
# Max DB connections per process. Keep servers x processes x this value below
# the database max_connections (production: 10).
DB_CONNECTION_LIMIT=20

# ============================================================
# REDIS (cache + shared rate limits)
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# ElastiCache with in-transit encryption: REDIS_TLS=true and the AUTH token
REDIS_TLS=false
REDIS_PASSWORD=

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================
# OTP
# ============================================================
# Provider: mock | twilio | msg91 | firebase
OTP_PROVIDER=mock
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 (optional)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ============================================================
# AWS S3
# ============================================================
AWS_REGION=ap-south-1
# Optional: leave both keys empty on EC2 to use the instance role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=digitag-uploads
AWS_S3_PUBLIC_URL=
AWS_S3_SIGNED_URL_EXPIRES_IN=900

# ============================================================
# RATE LIMIT
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
OTP_RATE_LIMIT_MAX=5
# memory | redis — use redis whenever more than one API process serves traffic
RATE_LIMIT_STORE=memory

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
