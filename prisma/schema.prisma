// =====================================================
// DigiTag — Prisma schema
// =====================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------
// Enums
// -------------------------
enum UserRole {
  CREATOR
  FREELANCER
  BRAND
  AGENCY
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CollaborationType {
  PAID
  UNPAID
}

enum OtpPurpose {
  LOGIN
  VERIFICATION
}

enum CollaborationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
}

enum InstagramVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum SocialPlatform {
  YOUTUBE
  FACEBOOK
}

enum SocialVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum FreelancerAvailability {
  AVAILABLE
  BUSY
  NOT_AVAILABLE
}

// -------------------------
// Category master (reusable across roles)
// -------------------------
model Category {
  id              String     @id @default(uuid())
  name            String     @unique
  slug            String     @unique
  description     String?
  applicableRoles UserRole[] @default([])
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  users              User[]
  creatorProfiles    CreatorProfile[]
  freelancerProfiles FreelancerProfile[]

  @@index([isActive])
}

// -------------------------
// Base auth/user table
// -------------------------
model User {
  id                 String     @id @default(uuid())
  mobileNumber       String     @unique
  countryCode        String     @default("+91")
  role               UserRole
  categoryId         String?
  isVerified         Boolean    @default(false)
  isProfileCompleted Boolean    @default(false)
  // Cached from the linked Subscription's status so the rest of the app can check
  // premium access with a plain field read instead of a join. Kept in sync by the
  // Razorpay webhook handler whenever the subscription's billing state changes.
  isPremium          Boolean    @default(false)
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?
  // Refreshed (throttled) on every authenticated request — drives real "Online" presence,
  // unlike lastLoginAt which only updates once per login and goes stale while the user is
  // actively using the app within the same session.
  lastActiveAt       DateTime?
  fcmToken           String?
  // Privacy Settings screen — all default to the app's existing behavior
  // (visible/on) so nothing changes for users until they actively opt out.
  isDiscoverable               Boolean  @default(true) // hide from Search when off
  showOnlineStatus             Boolean  @default(true) // hide lastActiveAt from chat partners when off
  shareDataForPersonalization  Boolean  @default(true) // stored preference; not yet read by any analytics/personalization system
  pushNotificationsEnabled     Boolean  @default(true) // gates non-call pushes; incoming calls always ring
  preferredLanguage            String   @default("English") // stored preference; UI copy itself is English-only today
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  category          Category?          @relation(fields: [categoryId], references: [id])
  creatorProfile    CreatorProfile?
  freelancerProfile FreelancerProfile?
  posts             Post[]
  refreshTokens     RefreshToken[]
  otps              Otp[]

  sentCollabs     Collaboration[] @relation("SentCollabs")
  receivedCollabs Collaboration[] @relation("ReceivedCollabs")

  conversationsA Conversation[] @relation("ParticipantA")
  conversationsB Conversation[] @relation("ParticipantB")
  sentMessages   Message[]      @relation("MessageSender")

  following Follow[] @relation("FollowFollower")
  followers Follow[] @relation("FollowFollowing")

  blocking  Block[] @relation("BlockBlocker")
  blockedBy Block[] @relation("BlockBlocked")

  subscription           Subscription?
  instagramVerifications InstagramVerification[]
  socialVerifications    SocialVerification[]
  callerCalls            Call[]                  @relation("CallCaller")
  calleeCalls            Call[]                  @relation("CallCallee")
  reports                Report[]                @relation("ReportReporter")
  savedPosts             SavedPost[]
  fcmDevices             FcmDevice[]

  @@index([role])
  @@index([mobileNumber])
  @@index([status])
  @@index([createdAt])
}

// -------------------------
// Creator profile — content creators, influencers, brand collaborators
// -------------------------
model CreatorProfile {
  id                   String            @id @default(uuid())
  userId               String            @unique
  profilePicture       String?
  profilePictureKey    String?
  name                 String?
  email                String?           @unique
  categoryId           String?
  categories           String[]          @default([])
  languages            String[]          @default([])
  language             String?
  bio                  String?
  location             String?
  // Social media presence
  instagramHandle      String?
  instagramFollowers   Int?
  youtubeHandle        String?
  youtubeFollowers     Int?
  twitterHandle        String?
  twitterFollowers     Int?
  snapchatHandle       String?
  snapchatFollowers    Int?
  facebookHandle       String?
  facebookFollowers    Int?
  portfolioUrl         String?
  experienceLevel      String?
  tagId                String?           @unique
  // Collaboration preferences
  preferredCollabType  CollaborationType @default(UNPAID)
  isAvailableForCollab Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isAvailableForCollab])
}

// -------------------------
// Freelancer profile — video editors, designers, photographers, writers
// -------------------------
model FreelancerProfile {
  id                String                 @id @default(uuid())
  userId            String                 @unique
  profilePicture    String?
  profilePictureKey String?
  name              String?
  email             String?                @unique
  categoryId        String?
  categories        String[]               @default([])
  languages         String[]               @default([])
  language          String?
  bio               String?
  location          String?
  // Freelancer-specific
  skills            String[]               @default([])
  hourlyRate        Decimal?               @db.Decimal(10, 2)
  experienceLevel   ExperienceLevel?
  portfolioUrl      String?
  availability      FreelancerAvailability @default(AVAILABLE)
  servicesOffered   String?
  // Social media presence
  instagramHandle      String?
  instagramFollowers   Int?
  youtubeHandle        String?
  youtubeFollowers     Int?
  twitterHandle        String?
  twitterFollowers     Int?
  snapchatHandle       String?
  snapchatFollowers    Int?
  facebookHandle       String?
  facebookFollowers    Int?
  tagId             String?                @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([availability])
}

// -------------------------
// Posts
// -------------------------
model Post {
  id                String            @id @default(uuid())
  userId            String
  role              UserRole
  description       String
  imageUrl          String?
  imageKey          String?
  location          String?
  collaborationType CollaborationType @default(UNPAID)
  category          String?
  budget            String?
  isActive          Boolean           @default(true)
  isHidden          Boolean           @default(false)
  // Optional "boost" expiry — null means the post stays live forever. When
  // set (from the creator's chosen boost duration), the post stops being
  // shown to other users once this passes, but the owner can still see it.
  expiresAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborations Collaboration[]
  savedBy        SavedPost[]

  @@index([role])
  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
  @@index([role, isActive, createdAt])
  @@index([expiresAt])
}

// -------------------------
// Saved / Bookmarked Posts
// -------------------------
model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

// -------------------------
// OTP storage (hashed)
// -------------------------
model Otp {
  id           String     @id @default(uuid())
  userId       String?
  mobileNumber String
  codeHash     String
  purpose      OtpPurpose @default(LOGIN)
  attempts     Int        @default(0)
  isUsed       Boolean    @default(false)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobileNumber])
  @@index([expiresAt])
}

// -------------------------
// Refresh tokens
// -------------------------
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// -------------------------
// Per-device FCM push tokens — one row per logged-in device, so pushes reach
// every active device and none of the logged-out ones. User.fcmToken is the
// legacy single-token column, still dual-written for older app builds.
// -------------------------
model FcmDevice {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String? // 'ios' | 'android'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------
// Collaboration requests
// -------------------------
model Collaboration {
  id          String              @id @default(uuid())
  senderId    String
  receiverId  String
  postId      String?
  message     String?
  status      CollaborationStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  sender       User          @relation("SentCollabs", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User          @relation("ReceivedCollabs", fields: [receiverId], references: [id], onDelete: Cascade)
  post         Post?         @relation(fields: [postId], references: [id], onDelete: SetNull)
  conversation Conversation?

  @@unique([senderId, receiverId, postId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([createdAt])
}

// -------------------------
// Conversations + messages
// -------------------------
model Conversation {
  id              String    @id @default(uuid())
  collaborationId String?   @unique
  participantAId  String
  participantBId  String
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collaboration Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  participantA  User           @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB  User           @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([participantAId, participantBId])
  @@index([lastMessageAt])
  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  imageUrl       String?
  isDeleted      Boolean  @default(false)
  isEdited       Boolean  @default(false)
  reactions      Json?
  // One-time location pin share (WhatsApp-style "Send Current Location"), not
  // live/continuous tracking — set together, always both null or both present.
  locationLat    Float?
  locationLng    Float?
  // WhatsApp-style reply: points at the quoted message. SetNull so deleting the
  // original leaves the reply intact, just without its quote.
  replyToId      String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([senderId])
  // Covers unread-count groupBy: senderId filter + isRead filter per conversation
  @@index([conversationId, senderId, isRead])
}

// -------------------------
// Follow graph
// -------------------------
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// -------------------------
// User blocks — abusive-user blocking (Apple 1.2 UGC requirement)
// -------------------------
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// -------------------------
// Instagram DM Verification
// -------------------------
model InstagramVerification {
  id                  String                     @id @default(uuid())
  userId              String
  instagramUrl        String
  instagramUsername   String
  verificationCode    String
  status              InstagramVerificationStatus @default(PENDING)
  expiresAt           DateTime
  verifiedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationCode])
  @@index([status, expiresAt])
}

model SocialVerification {
  id              String                    @id @default(uuid())
  userId          String
  platform        SocialPlatform
  status          SocialVerificationStatus  @default(PENDING)
  socialAccountId String?
  accountName     String?
  expiresAt       DateTime
  verifiedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, socialAccountId])
  @@index([userId, platform, status])
}

// -------------------------
// Calls
// -------------------------
model Call {
  id          String     @id @default(uuid())
  callerId    String
  calleeId    String
  channelName String     @unique
  status      CallStatus @default(RINGING)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  caller User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([calleeId])
  @@index([status])
}

// -------------------------
// Admin users (email + password, separate from OTP users)
// -------------------------
enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

model AdminUser {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               AdminRole @default(SUPER_ADMIN)
  isActive           Boolean   @default(true)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  activityLogs AdminActivityLog[]

  @@index([email])
}

// -------------------------
// Admin audit log
// -------------------------
model AdminActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  adminName String
  action    String
  target    String   @default("—")
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}

// -------------------------
// User/post reports
// -------------------------
enum ReportType {
  USER
  POST
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model Report {
  id         String       @id @default(uuid())
  type       ReportType
  targetId   String
  targetName String
  reason     String
  reportedBy String
  status     ReportStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter User @relation("ReportReporter", fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// Mirrors a Razorpay Subscription. One per user — kept in sync via the
// /webhooks/razorpay endpoint (subscription.activated/charged/cancelled/etc),
// since Razorpay is the source of truth for billing state.
enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  razorpaySubscriptionId String             @unique
  razorpayPlanId         String
  status                 SubscriptionStatus @default(CREATED)
  currentStart           DateTime?
  currentEnd             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}
