// =====================================================
// DigiTag — Prisma schema
// =====================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------
// Enums
// -------------------------
enum UserRole {
  CREATOR
  FREELANCER
  BRAND
  AGENCY
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CollaborationType {
  PAID
  UNPAID
}

enum PostStatus {
  OPEN
  COMPLETED
  CLOSED
}

enum OtpPurpose {
  LOGIN
  VERIFICATION
}

enum CollaborationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
}

enum InstagramVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
  REMOVED
}

enum SocialPlatform {
  YOUTUBE
  FACEBOOK
}

enum SocialVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum EmailVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum FreelancerAvailability {
  AVAILABLE
  BUSY
  NOT_AVAILABLE
}

// Brand -> media channel advertising (see MediaChannel / AdRequest below)
enum ChannelType {
  TV
  YOUTUBE
  RADIO
  OTT
  PRINT
  DIGITAL
  OTHER
}

enum AdRequestStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CANCELLED
  IN_PROGRESS
  COMPLETED
}

enum AdRequestActor {
  BRAND
  CHANNEL
  SYSTEM
}

enum ChannelUserRole {
  OWNER
  MANAGER
}

enum BrandApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// -------------------------
// Category master (reusable across roles)
// -------------------------
model Category {
  id              String     @id @default(uuid())
  name            String     @unique
  slug            String     @unique
  description     String?
  applicableRoles UserRole[] @default([])
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  users              User[]
  creatorProfiles    CreatorProfile[]
  freelancerProfiles FreelancerProfile[]

  @@index([isActive])
}

// -------------------------
// Account credentials table (Zomato/Blinkit style single login credentials)
// -------------------------
model Account {
  id           String   @id @default(uuid())
  mobileNumber String   @unique
  countryCode  String   @default("+91")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]
}

// -------------------------
// Base auth/user table
// -------------------------
model User {
  id                          String     @id @default(uuid())
  mobileNumber                String
  countryCode                 String     @default("+91")
  accountId                   String?
  role                        UserRole
  categoryId                  String?
  isVerified                  Boolean    @default(false)
  isProfileCompleted          Boolean    @default(false)
  // Cached from the linked Subscription's status so the rest of the app can check
  // premium access with a plain field read instead of a join. Kept in sync by the
  // Razorpay webhook handler whenever the subscription's billing state changes.
  isPremium                   Boolean    @default(false)
  status                      UserStatus @default(ACTIVE)
  lastLoginAt                 DateTime?
  // Refreshed (throttled) on every authenticated request — drives real "Online" presence,
  // unlike lastLoginAt which only updates once per login and goes stale while the user is
  // actively using the app within the same session.
  lastActiveAt                DateTime?
  fcmToken                    String?
  // Privacy Settings screen — all default to the app's existing behavior
  // (visible/on) so nothing changes for users until they actively opt out.
  isDiscoverable              Boolean    @default(true) // hide from Search when off
  showOnlineStatus            Boolean    @default(true) // hide lastActiveAt from chat partners when off
  shareDataForPersonalization Boolean    @default(true) // stored preference; not yet read by any analytics/personalization system
  pushNotificationsEnabled    Boolean    @default(true) // gates non-call pushes; incoming calls always ring
  // "Someone in my categories posted a requirement" — Freelancers get this for
  // Creator posts, Creators get it for Freelancer posts (see post.service.js
  // createPost). Separate from pushNotificationsEnabled since this is much
  // higher-volume than collab-based notifications and needs its own off switch.
  notifyCategoryPosts         Boolean    @default(true)
  preferredLanguage           String     @default("English") // stored preference; UI copy itself is English-only today
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  account           Account?           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category          Category?          @relation(fields: [categoryId], references: [id])
  creatorProfile    CreatorProfile?
  freelancerProfile FreelancerProfile?
  brandProfile      BrandProfile?
  posts             Post[]
  adRequests        AdRequest[]
  refreshTokens     RefreshToken[]
  otps              Otp[]

  sentCollabs     Collaboration[] @relation("SentCollabs")
  receivedCollabs Collaboration[] @relation("ReceivedCollabs")

  conversationsA Conversation[] @relation("ParticipantA")
  conversationsB Conversation[] @relation("ParticipantB")
  sentMessages   Message[]      @relation("MessageSender")

  following Follow[] @relation("FollowFollower")
  followers Follow[] @relation("FollowFollowing")

  blocking  Block[] @relation("BlockBlocker")
  blockedBy Block[] @relation("BlockBlocked")

  subscription           Subscription?
  instagramVerifications InstagramVerification[]
  socialVerifications    SocialVerification[]
  emailVerifications     EmailVerification[]
  callerCalls            Call[]                  @relation("CallCaller")
  calleeCalls            Call[]                  @relation("CallCallee")
  reports                Report[]                @relation("ReportReporter")
  savedPosts             SavedPost[]
  fcmDevices             FcmDevice[]
  notifications          Notification[]
  userTags               UserTag[]
  profileViewsMade       ProfileView[]           @relation("ProfileViewViewer")
  profileViewsReceived   ProfileView[]           @relation("ProfileViewViewed")

  @@index([role])
  @@index([mobileNumber])
  @@index([status])
  @@index([createdAt])
  @@index([accountId])
}

// -------------------------
// Creator profile — content creators, influencers, brand collaborators
// -------------------------
model CreatorProfile {
  id                   String            @id @default(uuid())
  userId               String            @unique
  profilePicture       String?
  profilePictureKey    String?
  name                 String?
  email                String?           @unique
  categoryId           String?
  categories           String[]          @default([])
  languages            String[]          @default([])
  language             String?
  bio                  String?
  location             String?
  // Social media presence
  instagramHandle      String?
  instagramFollowers   Int?
  youtubeHandle        String?
  youtubeFollowers     Int?
  twitterHandle        String?
  twitterFollowers     Int?
  snapchatHandle       String?
  snapchatFollowers    Int?
  facebookHandle       String?
  facebookFollowers    Int?
  portfolioUrl         String?
  experienceLevel      String?
  tagId                String?           @unique
  // Collaboration preferences
  preferredCollabType  CollaborationType @default(UNPAID)
  isAvailableForCollab Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isAvailableForCollab])
}

// -------------------------
// Freelancer profile — video editors, designers, photographers, writers
// -------------------------
model FreelancerProfile {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  profilePicture     String?
  profilePictureKey  String?
  name               String?
  email              String?                @unique
  categoryId         String?
  categories         String[]               @default([])
  languages          String[]               @default([])
  language           String?
  bio                String?
  location           String?
  // Freelancer-specific
  skills             String[]               @default([])
  hourlyRate         Decimal?               @db.Decimal(10, 2)
  experienceLevel    ExperienceLevel?
  portfolioUrl       String?
  availability       FreelancerAvailability @default(AVAILABLE)
  servicesOffered    String?
  // Social Media Manager-only: independent checkboxes, not a single choice —
  // a freelancer can offer both. Empty for every other category.
  workTypes          String[]               @default([])
  // Social media presence
  instagramHandle    String?
  instagramFollowers Int?
  youtubeHandle      String?
  youtubeFollowers   Int?
  twitterHandle      String?
  twitterFollowers   Int?
  snapchatHandle     String?
  snapchatFollowers  Int?
  facebookHandle     String?
  facebookFollowers  Int?
  tagId              String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([availability])
}

// -------------------------
// Brand profile — companies that advertise on media channels and post
// requirements for creators/freelancers. `name` + `profilePicture` mirror the
// other profile tables so generic "creatorProfile || freelancerProfile ||
// brandProfile" display code works unchanged (name = brand name, picture = logo).
//
// Brands sign up with KYC details (PAN required, GSTIN optional) and stay
// PENDING until an admin approves them from /admin/brands — only APPROVED
// brands can post requirements, collaborate or send ad requests.
// -------------------------
model BrandProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  name               String?
  profilePicture     String?
  profilePictureKey  String?
  email              String?             @unique
  pan                String?
  gstin              String?
  city               String?
  state              String?
  website            String?
  industry           String?
  bio                String?
  contactPerson      String?
  contactDesignation String?
  companySize        String?
  instagramHandle    String?
  youtubeHandle      String?
  tagId              String?             @unique
  approvalStatus     BrandApprovalStatus @default(PENDING)
  rejectionReason    String?
  reviewedAt         DateTime?
  reviewedBy         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus, createdAt])
}

// -------------------------
// Posts
// -------------------------
model Post {
  id                String            @id @default(uuid())
  userId            String
  role              UserRole
  description       String
  // Legacy single-image fields — kept in sync with imageUrls[0]/imageKeys[0]
  // for any consumer still reading the singular field.
  imageUrl          String?
  imageKey          String?
  // Portfolio-category posts (Photography, Property Rental, Fashion
  // Designers, Models, Styling & Makeup) can carry up to 3 work-sample
  // images — everything else still only ever populates the first slot.
  imageUrls         String[]          @default([])
  imageKeys         String[]          @default([])
  location          String?
  collaborationType CollaborationType @default(UNPAID)
  category          String?
  budget            String?
  isActive          Boolean           @default(true)
  isHidden          Boolean           @default(false)
  // Owner-driven lifecycle, separate from isActive (delete) and isHidden
  // (admin moderation): COMPLETED keeps the post visible as a record but
  // blocks new collaboration requests from anyone; CLOSED hides it from
  // feeds like a delete, but — unlike isActive — is meant to be reversible
  // by the owner reopening it.
  status            PostStatus        @default(OPEN)
  // Optional visibility window — null means the post stays live forever. When
  // set (from the creator's chosen "Post Visibility" duration at create time),
  // the post stops being shown to other users once this passes, but the
  // owner can still see it. Unrelated to boostedUntil below.
  expiresAt         DateTime?
  // Premium "Boost" feature: while boostedUntil is in the future, this post
  // sorts above everything else in feeds. boostedAt (when the boost button
  // was last pressed) is what the monthly-allowance count is based on, kept
  // separately from boostedUntil so a since-expired boost still counts
  // toward the month it was used, not silently reset by reading boostedUntil.
  boostedUntil      DateTime?
  boostedAt         DateTime?
  // Brand requirement posts only (role = BRAND). Who the requirement is shown
  // to: always includes CREATOR; FREELANCER only when the brand ticked
  // "freelancer required". Empty for Creator/Freelancer posts, which keep
  // using OPPOSITE_FEED_ROLE for visibility.
  title             String?
  targetRoles       UserRole[]        @default([])
  // Brand requirement details captured by the app's "Who are you looking
  // for?" composer (served through /brand-requirements). requirementTarget is
  // CREATORS or AGENCIES; viewCount counts views by creators/freelancers.
  requirementTarget String?
  creatorCountMin   Int?
  creatorCountMax   Int?
  genderPreference  String?
  deliverables      String?
  visibility        String?
  viewCount         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborations Collaboration[]
  savedBy        SavedPost[]

  @@index([role])
  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
  @@index([role, isActive, createdAt])
  @@index([expiresAt])
  @@index([boostedUntil])
}

// -------------------------
// Saved / Bookmarked Posts
// -------------------------
model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

// -------------------------
// OTP storage (hashed)
// -------------------------
model Otp {
  id           String     @id @default(uuid())
  userId       String?
  mobileNumber String
  codeHash     String
  purpose      OtpPurpose @default(LOGIN)
  attempts     Int        @default(0)
  isUsed       Boolean    @default(false)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobileNumber])
  @@index([expiresAt])
}

// -------------------------
// Refresh tokens
// -------------------------
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// -------------------------
// Per-device FCM push tokens — one row per logged-in device, so pushes reach
// every active device and none of the logged-out ones. User.fcmToken is the
// legacy single-token column, still dual-written for older app builds.
// -------------------------
model FcmDevice {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String? // 'ios' | 'android'
  // PushKit VoIP token (iOS only) — separate from the FCM token above.
  // Incoming calls are sent here via direct APNs VoIP push instead of FCM so
  // they reliably wake the app and ring via CallKit even when it's fully
  // backgrounded or killed, which a regular FCM push can't guarantee on iOS.
  voipToken String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------
// Collaboration requests
// -------------------------
model Collaboration {
  id          String              @id @default(uuid())
  senderId    String
  receiverId  String
  postId      String?
  message     String?
  status      CollaborationStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  sender       User          @relation("SentCollabs", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User          @relation("ReceivedCollabs", fields: [receiverId], references: [id], onDelete: Cascade)
  post         Post?         @relation(fields: [postId], references: [id], onDelete: SetNull)
  conversation Conversation?

  @@unique([senderId, receiverId, postId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([createdAt])
}

// -------------------------
// Conversations + messages
// -------------------------
model Conversation {
  id              String    @id @default(uuid())
  collaborationId String?   @unique
  participantAId  String
  participantBId  String
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collaboration Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  participantA  User           @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB  User           @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([participantAId, participantBId])
  @@index([lastMessageAt])
  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  imageUrl       String?
  isDeleted      Boolean  @default(false)
  isEdited       Boolean  @default(false)
  reactions      Json?
  // One-time location pin share (WhatsApp-style "Send Current Location"), not
  // live/continuous tracking — set together, always both null or both present.
  locationLat    Float?
  locationLng    Float?
  // WhatsApp-style reply: points at the quoted message. SetNull so deleting the
  // original leaves the reply intact, just without its quote.
  replyToId      String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([senderId])
  // Covers unread-count groupBy: senderId filter + isRead filter per conversation
  @@index([conversationId, senderId, isRead])
}

// -------------------------
// Notifications — durable record of every push sent to a user (new message,
// collab request/accepted/declined, new post), independent of whether the
// push itself was ever delivered. Call signaling (ringing, call lifecycle)
// is intentionally NOT persisted here — it's transient by nature.
// -------------------------
model Notification {
  id          String    @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String
  data        Json?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  // Only set for rows created by an admin Broadcast — lets read-rate be
  // computed live (count isRead=true vs total per broadcastId) instead of
  // maintaining a counter that could drift out of sync.
  broadcastId String?
  createdAt   DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([broadcastId])
}

// -------------------------
// Follow graph
// -------------------------
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// -------------------------
// User blocks — abusive-user blocking (Apple 1.2 UGC requirement)
// -------------------------
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// -------------------------
// Premium: "Who Viewed My Profile"
// -------------------------
// One row per (viewer, viewed) pair — re-viewing updates viewedAt in place
// rather than growing unbounded, which also naturally gives "most recently
// viewed first" ordering for free via a simple sort.
model ProfileView {
  id       String   @id @default(uuid())
  viewerId String
  viewedId String
  viewedAt DateTime @default(now())

  viewer User @relation("ProfileViewViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewed User @relation("ProfileViewViewed", fields: [viewedId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedId])
  @@index([viewedId, viewedAt])
}

// -------------------------
// Instagram DM Verification
// -------------------------
model InstagramVerification {
  id                String                      @id @default(uuid())
  userId            String
  instagramUrl      String
  instagramUsername String
  verificationCode  String
  status            InstagramVerificationStatus @default(PENDING)
  followers         Int?
  expiresAt         DateTime
  verifiedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationCode])
  @@index([status, expiresAt])
}

model SocialVerification {
  id              String                   @id @default(uuid())
  userId          String
  platform        SocialPlatform
  status          SocialVerificationStatus @default(PENDING)
  socialAccountId String?
  accountName     String?
  failureReason   String?
  expiresAt       DateTime
  verifiedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, socialAccountId])
  @@index([userId, platform, status])
}

// -------------------------
// Email verification — signup requires a verified email; the code is sent
// to the address itself (not tied to a profile row yet), so this can run
// before a CreatorProfile/FreelancerProfile exists. The submitting profile
// endpoint checks for a VERIFIED row matching (userId, email) at save time.
// -------------------------
model EmailVerification {
  id            String                  @id @default(uuid())
  userId        String
  email         String
  codeHash      String
  status        EmailVerificationStatus @default(PENDING)
  attempts      Int                     @default(0)
  failureReason String?
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email, status])
  @@index([expiresAt])
}

// -------------------------
// Calls
// -------------------------
model Call {
  id          String     @id @default(uuid())
  callerId    String
  calleeId    String
  channelName String     @unique
  status      CallStatus @default(RINGING)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  caller User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([calleeId])
  @@index([status])
}

// -------------------------
// Admin users (email + password, separate from OTP users)
// -------------------------
enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

model AdminUser {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             AdminRole @default(SUPER_ADMIN)
  isActive         Boolean   @default(true)
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activityLogs AdminActivityLog[]
  broadcasts   Broadcast[]        @relation("BroadcastCreatedBy")

  @@index([email])
}

// -------------------------
// Admin broadcast notifications
// -------------------------
enum BroadcastStatus {
  SENT
  SCHEDULED
  PENDING_APPROVAL
  REJECTED
  FAILED
}

model Broadcast {
  id             String          @id @default(uuid())
  title          String
  body           String
  target         String
  categoryId     String?
  userIds        String[]        @default([])
  // Composable "custom segment" filter, only set when target === 'segment':
  // { role?, categoryId?, inactiveDays?, isPremium? }, combined with AND.
  segment        Json?
  action         String          @default("NONE")
  postId         String?
  profileUserId  String?
  imageUrl       String?
  status         BroadcastStatus @default(SENT)
  scheduledFor   DateTime?
  recipientCount Int             @default(0)
  sentCount      Int             @default(0)
  createdById    String
  createdByName  String
  approvedById   String?
  approvedByName String?
  rejectedReason String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  createdBy     AdminUser      @relation("BroadcastCreatedBy", fields: [createdById], references: [id])
  notifications Notification[]

  @@index([status])
  @@index([createdAt])
  @@index([scheduledFor])
}

// -------------------------
// Admin audit log
// -------------------------
model AdminActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  adminName String
  action    String
  target    String   @default("—")
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}

// -------------------------
// User/post reports
// -------------------------
enum ReportType {
  USER
  POST
  // App bug/feedback report from the Report Issue screen — surfaces in the
  // same admin Reports queue as user/post reports.
  ISSUE
}

// The "DigiTag": an internal tag generated at signup from the user's
// location + language + role char + 5 random digits (e.g. HYD-TEL-C-48291).
// Deliberately its own table, NOT a profile column — profile objects are
// returned by many public endpoints, and this tag is for admin/staff eyes
// only. Linked to the user's public tagId (245C457-style) via userId.
model UserTag {
  id        String   @id @default(uuid())
  userId    String
  role      UserRole
  tag       String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// "Notify Me" waitlist from the home hero's Brands/Agencies coming-soon slide.
model LaunchWaitlist {
  id           String   @id @default(uuid())
  mobileNumber String   @unique
  createdAt    DateTime @default(now())
}

// Public event registration (e.g. celebrity meet-and-greets) — register on
// the website, get a ticket with a QR code, staff scan it at the door to
// check in. eventSlug is the one reusability hook: a future event just needs
// a new slug + website page content, not a schema/backend change.
model EventRegistration {
  id             String    @id @default(uuid())
  eventSlug      String
  name           String
  email          String
  mobileNumber   String
  instagramLink  String
  location       String
  ticketCode     String    @unique @default(uuid())
  checkedIn      Boolean   @default(false)
  checkedInAt    DateTime?
  checkedInBy    String?
  whatsappStatus String?
  createdAt      DateTime  @default(now())

  @@unique([eventSlug, mobileNumber])
  @@unique([eventSlug, email])
  @@index([eventSlug])
  @@index([ticketCode])
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model Report {
  id            String       @id @default(uuid())
  type          ReportType
  targetId      String
  targetName    String
  reason        String
  reportedBy    String
  status        ReportStatus @default(PENDING)
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  // True for the row block.service.js auto-creates whenever someone blocks a
  // user (admin moderation trail only) — NOT an explicit user report. Kept
  // false for real reports so "did I report this?" and the duplicate-report
  // guard only ever look at reports the user actually chose to submit.
  autoGenerated Boolean      @default(false)

  reporter User @relation("ReportReporter", fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// Mirrors a Razorpay Subscription. One per user — kept in sync via the
// /webhooks/razorpay endpoint (subscription.activated/charged/cancelled/etc),
// since Razorpay is the source of truth for billing state.
enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum SubscriptionProvider {
  RAZORPAY
  APPLE
}

model Subscription {
  id                         String               @id @default(uuid())
  userId                     String               @unique
  // Android/web go through Razorpay; iOS must use StoreKit per Apple 3.1.1 —
  // provider says which billing system owns this row. Razorpay fields stay
  // required-shaped in practice but are nullable so an Apple row doesn't need
  // fake Razorpay ids, and vice versa.
  provider                   SubscriptionProvider @default(RAZORPAY)
  razorpaySubscriptionId     String?              @unique
  razorpayPlanId             String?
  // Apple's own subscription identity: originalTransactionId stays the same
  // across renewals of the same subscription (that's what Server
  // Notifications key off), transactionId is the latest individual purchase/
  // renewal event.
  appleOriginalTransactionId String?              @unique
  appleTransactionId         String?
  appleProductId             String?
  status                     SubscriptionStatus   @default(CREATED)
  currentStart               DateTime?
  currentEnd                 DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// =====================================================
// Brand advertising on media channels
// =====================================================
// A brand picks a MediaChannel (TV / YouTube / ...), picks an AdType, browses
// that channel's catalog (rate card), and sends an AdRequest with one or more
// catalog items. The channel's team works the request from the channel CRM,
// which authenticates as a ChannelUser (email + password, separate from app
// OTP users — same split as AdminUser).

// Powers the "Top YouTube Channels" section on the Brand Home tab (admin page
// /admin/youtube-channels). `type` lets TV channels live in the same table.
model MediaChannel {
  id              String      @id @default(uuid())
  name            String
  slug            String      @unique
  type            ChannelType @default(YOUTUBE)
  logoUrl         String?
  logoKey         String?
  subscriberCount Int         @default(0)
  category        String?
  description     String?
  languages       String[]    @default([])
  region          String?
  websiteUrl      String?
  contactEmail    String?
  contactPhone    String?
  isActive        Boolean     @default(true)
  isVerified      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  catalogItems ChannelCatalogItem[]
  adRequests   AdRequest[]
  users        ChannelUser[]
  showcases    ChannelShowcase[]

  @@index([type, isActive, subscriberCount])
}

// Powers the "Ad Types" section on the Brand Home tab (Strip Ad, Banner Ad,
// Corner Ads...), managed from /admin/ad-types. App-wide — each channel's
// catalog prices whichever of these it offers.
model AdType {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  iconUrl     String?
  accentColor String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  catalogItems ChannelCatalogItem[]
}

// Powers the "Celebrities" section on the Brand Home tab (/admin/celebrities).
model Celebrity {
  id            String   @id @default(uuid())
  name          String
  photoUrl      String?
  role          String?
  followerCount Int      @default(0)
  isVerified    Boolean  @default(false)
  profileUrl    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, followerCount])
}

// One rate-card line on a channel's catalog.
model ChannelCatalogItem {
  id              String   @id @default(uuid())
  channelId       String
  adTypeId        String
  name            String
  description     String?
  // What one unit of `price` buys, e.g. "per 10 sec spot", "per video".
  unit            String
  price           Decimal  @db.Decimal(12, 2)
  currency        String   @default("INR")
  minQuantity     Int      @default(1)
  // Optional slot/placement detail, e.g. "Prime time 8-10 PM".
  slot            String?
  durationSeconds Int?
  mediaUrl        String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  channel      MediaChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  adType       AdType          @relation(fields: [adTypeId], references: [id])
  requestItems AdRequestItem[]

  @@index([channelId, adTypeId, isActive])
}

model AdRequest {
  id           String          @id @default(uuid())
  brandUserId  String
  channelId    String
  status       AdRequestStatus @default(PENDING)
  campaignName String?
  brief        String?
  startDate    DateTime?
  endDate      DateTime?
  budget       Decimal?        @db.Decimal(14, 2)
  // Sum of item lineTotals at send time — items snapshot their price, so a
  // later rate-card change never rewrites what the brand was quoted.
  totalAmount  Decimal         @db.Decimal(14, 2)
  currency     String          @default("INR")
  // Latest message from the channel to the brand (also kept in events).
  channelNote  String?
  respondedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  brand   User             @relation(fields: [brandUserId], references: [id], onDelete: Cascade)
  channel MediaChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  items   AdRequestItem[]
  events  AdRequestEvent[]

  @@index([brandUserId, createdAt])
  @@index([channelId, status, createdAt])
}

model AdRequestItem {
  id            String   @id @default(uuid())
  requestId     String
  catalogItemId String?
  // Snapshots of the catalog line at request time.
  adTypeName    String
  itemName      String
  unit          String
  unitPrice     Decimal  @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal  @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now())

  request     AdRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  catalogItem ChannelCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

// Timeline for the CRM: every status change and note, by either side.
model AdRequestEvent {
  id         String           @id @default(uuid())
  requestId  String
  actor      AdRequestActor
  actorId    String?
  actorName  String?
  fromStatus AdRequestStatus?
  toStatus   AdRequestStatus?
  note       String?
  createdAt  DateTime         @default(now())

  request AdRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

// Channel CRM login.
model ChannelUser {
  id           String          @id @default(uuid())
  channelId    String
  name         String
  email        String          @unique
  passwordHash String
  role         ChannelUserRole @default(MANAGER)
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  channel MediaChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

// A past brand collaboration a channel showcases from the CRM — shown on the
// channel's profile in the brand app. Entered by the channel, so it can cover
// deals done before (or outside) Digitag; not derived from AdRequests.
model ChannelShowcase {
  id           String    @id @default(uuid())
  channelId    String
  brandName    String
  brandLogoUrl String?
  title        String
  description  String?
  // Image or video of the delivered ad.
  mediaUrl     String?
  adTypeName   String?
  campaignDate DateTime?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  channel MediaChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, isActive, sortOrder])
}

enum CelebrityApplicationStatus {
  REQUESTED // contact form sent, onboarding not finished
  SUBMITTED // onboarding signed, awaiting admin review
  APPROVED
  REJECTED
}

// A celebrity / creator onboarded through the website's Celebrity panel. The
// DigiTag team fills in the onboarding with the celebrity, so the row is
// created already SUBMITTED. REQUESTED rows (and phone / email /
// submitTokenHash) are from the old contact-form-first flow.
model CelebrityApplication {
  id     String                     @id @default(uuid())
  status CelebrityApplicationStatus @default(REQUESTED)

  // Contact (name = legal name, category = partner type for team onboardings)
  name            String
  phone           String?
  email           String?
  category        String
  availability    String?
  interested      Boolean  @default(true)
  termsAcceptedAt DateTime

  // Onboarding (steps 2–6)
  onboardingDate    DateTime?
  effectiveDate     DateTime?
  legalName         String?
  partnerType       String?
  instagramHandles  String[]  @default([])
  youtubeChannels   Json? // [{ name, url }]
  brandIntegrations String[]  @default([])
  managementAgreed  Boolean   @default(false)
  signatureKey      String? // private S3 object, served to admins via signed URL
  signedName        String?
  signedDate        DateTime?
  submittedAt       DateTime?

  submitTokenHash String?
  ipAddress       String?
  userAgent       String?

  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
